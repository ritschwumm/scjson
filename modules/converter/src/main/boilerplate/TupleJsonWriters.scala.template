package scjson.converter

import scutil.lang.*
import scutil.lang.extension.TupleExtensions.*

import scjson.ast.*

trait TupleJsonWriters {
	[#given Tuple1Writer:[[#T1#]] => ([#f1:JsonWriter[T1]#]) => JsonWriter[Tuple1[[#T1#]]]	=
		Converter[JsonError, Tuple1[[#T1#]], JsonValue] { input =>
			Tuple1(
				[#f1.convert(input._1),#
				]
			)
			.productN
			.map { values	=>
				JsonValue.fromItems(
					Vector(
						[#values._1,#
						]
					)
				)
			}
		}#

	]
}
