package scjson.converter

import scutil.lang.*
import scutil.lang.extension.TupleExtensions.*

import scjson.ast.*

trait TupleJsonWriters {
	[#given Tuple1Writer:[[#T1#]] => ([#f1:JsonWriter[T1]#]) => JsonWriter[Tuple1[[#T1#]]]	=
		Converter[JsonError, Tuple1[[#T1#]], Tuple1[[#JsonValue#]]] { values =>
			values
			.ap(
				Tuple1(
					[#f1.convert#,
					]
				)
			)
			.zipN
		} >=>
		TupleConverters.tuple1ToSeq >=>
		JsonConverters.makeArray#

	]
}
