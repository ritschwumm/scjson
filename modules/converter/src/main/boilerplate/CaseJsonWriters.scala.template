package scjson.converter

import scala.annotation.nowarn
import scala.deriving.Mirror
import scala.compiletime.*

import scutil.lang.*
import scutil.lang.extension.TupleExtensions.*

import scjson.ast.*

trait CaseJsonWriters {
	@nowarn("msg=unused explicit parameter")
	def coWriter[T](value:T):JsonWriter[T]	=
		UnitConverters.UnitWriter.contraMap(constant(()))

	/*
	def cc0Writer[T]:JsonWriter[T]	=
		UnitConverters.UnitWriter.contraMap(constant(()))
	*/

	def cc0AutoWriter[T<:Product]:JsonWriter[T]	=
		UnitConverters.UnitWriter.contraMap(constant(()))

	[#inline def cc1AutoWriter[T<:Product](using
		m:Mirror.ProductOf[T],
		sz:Tuple.Size[m.MirroredElemTypes] =:= 1,
		[#f1:JsonWriter[Tuple.Elem[m.MirroredElemTypes, 0]]#],
	):JsonWriter[T]	=
		Converter { (input:T) =>
			val values	= Tuple.fromProductTyped(input)(using m)

			Tuple1(
				[#f1.convert(values(0)),#
				]
			)
			.productN
			.map { values	=>
				JsonValue.fromFields(
					Vector[(String, JsonValue)](
						[#(constValue[Tuple.Elem[m.MirroredElemLabels, 0] & String], values._1),#
						]
					)
				)
			}
		}#

	]
}
