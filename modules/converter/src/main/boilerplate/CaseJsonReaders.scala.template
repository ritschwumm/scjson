package scjson.converter

import scala.deriving.Mirror
import scala.compiletime.*

import scutil.lang.*
import scutil.lang.extension.TupleExtensions.*
import scutil.lang.extension.OptionExtensions.*

import scjson.ast.*

trait CaseJsonReaders {
	def coReader[T](value:T):JsonReader[T]	=
		UnitConverters.UnitReader.map(constant(value))

	/*
	def cc0Reader[S](apply:()=>T):JsonReader[T]	=
		UnitConverters.UnitReader.map { _ => apply() }
	*/

	def cc0AutoReader[T](using m:Mirror.ProductOf[T] { type MirroredElemTypes = EmptyTuple }):JsonReader[T]	=
		UnitConverters.UnitReader.map { _ =>
			m.fromProduct(EmptyTuple)
		}

	[#inline def cc1AutoReader[T](using
		m:Mirror.ProductOf[T],
		sz:Tuple.Size[m.MirroredElemTypes] =:= 1,
		[#f1:JsonReader[Tuple.Elem[m.MirroredElemTypes, 0]]#],
	):JsonReader[T]	=
		JsonConverters.expectObjectMap	>=>
		Converter { (input:Map[String, JsonValue]) =>
			if input.size == 1 then {
				Tuple1(
					[#input.get(constValue[Tuple.Elem[m.MirroredElemLabels, 0] & String]).toValid(JsonError(s"missing element ${constValue[Tuple.Elem[m.MirroredElemLabels, 0] & String]}")).flatMap(f1.convert),#
					]
				)
				.productN
				.map(m.fromProduct)
			}
			else {
				Validated.invalid(JsonError(s"expected 1, not ${input.size.toString} value(s)"))
			}
		}#

	]
}
